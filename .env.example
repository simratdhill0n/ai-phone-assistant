APP_ENV=dev

# Public tunnel domain, no https:// (e.g. abc123.ngrok-free.dev)
PUBLIC_HOST=

# Twilio (Console > Account > API keys & tokens). Numbers in +1 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Owner: who the assistant works for. OWNER_PHONE is the only number allowed to send notes.
OWNER_NAME=
OWNER_PHONE=
OWNER_TIMEZONE=America/Toronto

ASSISTANT_NAME=Nova

DATABASE_URL=sqlite:///assistant.db

# Any model pulled with `ollama pull`
OLLAMA_MODEL=qwen2.5:7b

# Whisper: GPU = cuda + float16, CPU = cpu + int8
WHISPER_MODEL=small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# TTS_ENGINE: kokoro (natural) or piper (light). KOKORO_DEVICE: cuda or cpu.
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_DEVICE=cuda
PIPER_VOICE_PATH=

VAD_ENGINE=energy