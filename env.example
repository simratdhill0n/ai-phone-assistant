# Copy to .env.dev (or .env.prod) and fill in. Never commit the real file.

# Public HTTPS domain Twilio calls (your tunnel), without https://
PUBLIC_HOST=your-domain.ngrok-free.dev

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15195550100

# Who the assistant works for
OWNER_NAME=Your Name
OWNER_PHONE=+15195550123
OWNER_TIMEZONE=America/Toronto
ASSISTANT_NAME=Nova

# Storage
DATABASE_URL=sqlite:///assistant.db

# Models
OLLAMA_MODEL=qwen2.5:14b
WHISPER_MODEL=small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_DEVICE=cuda
PIPER_VOICE_PATH=
VAD_ENGINE=silero

# Urgent-call transfer
TRANSFER_ENABLED=true
TRANSFER_RING_SECONDS=20

# Google Calendar (leave GOOGLE_CALENDAR_ID empty to turn it off)
GOOGLE_CALENDAR_ID=
GOOGLE_NOVA_CALENDAR_ID=
GOOGLE_CREDENTIALS_PATH=google-service-account.json
